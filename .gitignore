# Python virtual env
.venv/
.venv-postulacion/
venv/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pytest-tmp/
.pytest-tmp*/

# Data / SQLite databases generated locally
data/*.db
data/cache/
vera.db*
talentia.db*
