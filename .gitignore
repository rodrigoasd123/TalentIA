*.db-wal
*.sqlite3
storage/

# Environment credentials
.env*
!.env.example
.vera_dev_key
.talentia_dev_key

# Temporary files
tmp/
output/
.vscode/
# Local development agents and dependency caches
.agents/
.pip-cache/
skills-lock.json

# Local application logs
postulaia.stdout.log
postulaia.stderr.log
*.log
