GEMINI_API_KEY=coloca_aqui_tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini
TALENTIA_MLFLOW_ENABLED=true
TALENTIA_MLFLOW_TRACKING_URI=
TALENTIA_MLFLOW_EXPERIMENT_NAME=TalentIA-LLM
TALENTIA_MLFLOW_UI_URL=http://127.0.0.1:5000

# El uso de Gemini Free Tier queda limitado a datos sintéticos. La futura
# foundation de agentes mantendrá deshabilitado el envío de CV/PII real hasta
# aprobación explícita de Security/Legal.

# Configuración estática opcional del ATS local. No pongas secretos reales aquí.
TALENTIA_ENVIRONMENT=development
TALENTIA_DATABASE_URL=sqlite:///./talentia.db
TALENTIA_API_BASE_URL=http://127.0.0.1:8000
TALENTIA_FF_DRY_RUN=true
TALENTIA_IMPORT_MAX_FILE_MB=20
TALENTIA_IMPORT_MAX_ROWS=10000
TALENTIA_IMPORT_STORAGE_PATH=./storage/imports

# OpenAI Config
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=1000

# Nuevo runtime greenfield (SPEC-030)
TALENTIA_ENV=desarrollo
TALENTIA_GREENFIELD_DATABASE_URL=sqlite:///./talentia_greenfield.db
TALENTIA_SESSION_SECRET=
TALENTIA_ADMIN_EMAIL=
TALENTIA_ADMIN_PASSWORD=
TALENTIA_ADMIN_NAME=Administracion del piloto
TALENTIA_DOCUMENT_STORAGE=storage/greenfield
TALENTIA_MAX_UPLOAD_MB=10
TALENTIA_SESSION_MINUTES=30
TALENTIA_JOB_ATTEMPTS=3
TALENTIA_LLM_TIMEOUT_SECONDS=60
TALENTIA_LLM_PROVIDER=
