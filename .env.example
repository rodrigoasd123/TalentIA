# Copie este archivo como .env solo para uso local. Nunca confirme secretos.
TALENTIA_ENV=desarrollo
TALENTIA_GREENFIELD_DATABASE_URL=sqlite:///./talentia_greenfield.db
TALENTIA_SESSION_SECRET=
TALENTIA_ADMIN_EMAIL=
TALENTIA_ADMIN_PASSWORD=
TALENTIA_ADMIN_NAME=Administracion del piloto
TALENTIA_DOCUMENT_STORAGE=storage/greenfield
TALENTIA_MAX_UPLOAD_MB=10
TALENTIA_SESSION_MINUTES=30
TALENTIA_LOGIN_MAX_ATTEMPTS=5
TALENTIA_LOGIN_LOCK_MINUTES=15
TALENTIA_PASSWORD_MAX_AGE_DAYS=90
TALENTIA_JOB_ATTEMPTS=3
TALENTIA_LLM_TIMEOUT_SECONDS=60

# Mantener vacio conserva el modo manual. Tambien puede gestionarse desde el panel administrativo.
TALENTIA_LLM_PROVIDER=
TALENTIA_LLM_MODEL=deterministico-local
OPENAI_API_KEY=
GEMINI_API_KEY=

# MLflow es opcional y degradable. No recibe prompts, respuestas, CV ni secretos.
TALENTIA_MLFLOW_TRACKING_URI=
TALENTIA_MLFLOW_URL=http://127.0.0.1:5000
