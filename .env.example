GEMINI_API_KEY=coloca_aqui_tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=gemini

# El uso de Gemini Free Tier queda limitado a datos sintéticos. La futura
# foundation de agentes mantendrá deshabilitado el envío de CV/PII real hasta
# aprobación explícita de Security/Legal.

# Configuración estática opcional del ATS local. No pongas secretos reales aquí.
TALENTIA_ENVIRONMENT=development
TALENTIA_DATABASE_URL=sqlite:///./talentia.db
TALENTIA_API_BASE_URL=http://127.0.0.1:8000
TALENTIA_FF_DRY_RUN=true
TALENTIA_IMPORT_MAX_FILE_MB=20
TALENTIA_IMPORT_MAX_ROWS=10000
TALENTIA_IMPORT_STORAGE_PATH=./storage/imports
